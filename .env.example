# Port the HTTP server listens on
PORT=3000

# Comma-separated list of allowed CORS origins (e.g. the React frontend's URL)
CORS_ORIGIN=http://localhost:5173

# Postgres connection string
DATABASE_URL=

# JWT access token secret, min. 32 chars
JWT_ACCESS_SECRET=
# JWT refresh token secret, min. 32 chars (must differ from JWT_ACCESS_SECRET)
JWT_REFRESH_SECRET=
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (e.g. 7d)
JWT_REFRESH_EXPIRES_IN=7d

# Password for the initial ADMIN user created by the seeder on first boot
SEED_ADMIN_PASSWORD=

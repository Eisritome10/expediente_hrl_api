meta {
  name: 01-login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("adminUserId", res.body.user.id);
    const runId = Date.now();
    bru.setVar("runId", runId.toString());
    const base = 10000000 + (runId % 89999997);
    bru.setVar("dniPrincipal", base.toString());
    bru.setVar("dniCo", (base + 1).toString());
    bru.setVar("dniAsesor", (base + 2).toString());
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.user.role: eq ADMIN
}

meta {
  name: 01-create-protocol
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/protocols
  body: json
  auth: inherit
}

body:json {
  {
    "nroExpediente": "BRUNO-{{runId}}",
    "fechaRecepcion": "2026-01-15",
    "titulo": "Estudio de prueba Bruno",
    "lugarEjecucion": "Hospital Regional de Loreto",
    "esInstitucional": true,
    "investigadorPrincipalId": "{{investigadorPrincipalId}}",
    "coinvestigadorIds": ["{{coinvestigadorId}}"],
    "asesorIds": ["{{asesorId}}"],
    "institucionId": "{{institucionId}}",
    "facultadId": "{{facultadId}}",
    "convenioId": "{{convenioId}}",
    "destinoIds": ["{{destinoId}}"],
    "studyDesignIds": ["{{studyDesignId}}"],
    "lineaHrlId": "{{lineaHrlId}}",
    "lineaMeta2030Id": "{{lineaMeta2030Id}}",
    "modalidadId": "{{modalidadId}}",
    "propositoRevision": "Revision inicial",
    "requiereRevisionHc": false,
    "certificadoBuenasPracticas": true
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("protocolId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.status: eq CREATED
  res.body.esConvenio: eq true
  res.body.pagoRevision: eq 0
}

meta {
  name: 04-patch-while-created-fails
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/protocols/{{protocolId}}
  body: json
  auth: inherit
}

body:json {
  {
    "titulo": "No deberia poder editarse todavia"
  }
}

assert {
  res.status: eq 409
  res.body.errorCode: eq PROTOCOL_NOT_OBSERVED
}

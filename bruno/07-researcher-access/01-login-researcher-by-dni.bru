meta {
  name: 01-login-researcher-by-dni
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "{{dniPrincipal}}",
    "password": "{{dniPrincipal}}"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("researcherToken", res.body.accessToken);
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.user.role: eq RESEARCHER
}

tests {
  test("username is the researcher DNI", function () {
    expect(res.body.user.username).to.equal(String(bru.getVar("dniPrincipal")));
  });
}

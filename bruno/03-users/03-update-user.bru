meta {
  name: 03-update-user
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/{{throwawayUserId}}
  body: json
  auth: inherit
}

body:json {
  {
    "fullName": "Usuario de Prueba Bruno Actualizado"
  }
}

assert {
  res.status: eq 200
  res.body.fullName: eq Usuario de Prueba Bruno Actualizado
}

meta {
  name: 01-create-user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "username": "bruno.{{runId}}",
    "fullName": "Usuario de Prueba Bruno",
    "password": "PasswordSegura123",
    "role": "NURSE"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("throwawayUserId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.passwordHash: isUndefined
}

meta {
  name: 10-create-researcher-coinvestigador
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/researchers
  body: json
  auth: inherit
}

body:json {
  {
    "dni": "{{dniCo}}",
    "firstName": "Maria",
    "lastName": "Coinvestigadora Bruno",
    "email": "co.bruno.{{runId}}@example.com"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("coinvestigadorId", res.body.id);
}

assert {
  res.status: eq 201
}

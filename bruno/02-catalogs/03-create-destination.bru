meta {
  name: 03-create-destination
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/destinations
  body: json
  auth: inherit
}

body:json {
  {
    "description": "DESTINO BRUNO {{runId}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("destinoId", res.body.id);
}

assert {
  res.status: eq 201
}

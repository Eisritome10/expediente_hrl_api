meta {
  name: 04-create-modality
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/modalities
  body: json
  auth: inherit
}

body:json {
  {
    "name": "MODALIDAD BRUNO {{runId}}",
    "fee": 150.5
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("modalidadId", res.body.id);
}

assert {
  res.status: eq 201
}

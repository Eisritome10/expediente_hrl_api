meta {
  name: 01-create-institution
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/institutions
  body: json
  auth: inherit
}

body:json {
  {
    "name": "UNIVERSIDAD BRUNO {{runId}}",
    "esUniversidad": true
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("institucionId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.esUniversidad: eq true
}

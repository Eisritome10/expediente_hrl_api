meta {
  name: 09-create-researcher-principal
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/researchers
  body: json
  auth: inherit
}

body:json {
  {
    "dni": "{{dniPrincipal}}",
    "firstName": "Juan",
    "lastName": "Principal Bruno",
    "email": "principal.bruno.{{runId}}@example.com"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("investigadorPrincipalId", res.body.id);
}

assert {
  res.status: eq 201
}

meta {
  name: 07-create-research-line-hrl
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/research-lines
  body: json
  auth: inherit
}

body:json {
  {
    "name": "LINEA HRL BRUNO {{runId}}",
    "type": "HRL"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("lineaHrlId", res.body.id);
}

assert {
  res.status: eq 201
}

meta {
  name: 06-create-agreement
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/agreements
  body: json
  auth: inherit
}

body:json {
  {
    "name": "CONVENIO BRUNO {{runId}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("convenioId", res.body.id);
}

assert {
  res.status: eq 201
}

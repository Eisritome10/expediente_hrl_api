meta {
  name: 05-create-study-design
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/study-designs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "DISENO BRUNO {{runId}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("studyDesignId", res.body.id);
}

assert {
  res.status: eq 201
}

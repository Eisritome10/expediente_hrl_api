meta {
  name: 08-create-research-line-meta2030
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/research-lines
  body: json
  auth: inherit
}

body:json {
  {
    "name": "LINEA META2030 BRUNO {{runId}}",
    "type": "META_2030"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("lineaMeta2030Id", res.body.id);
}

assert {
  res.status: eq 201
}

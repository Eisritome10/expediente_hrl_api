meta {
  name: 01-observe-without-observations-fails
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "status": "OBSERVED"
  }
}

assert {
  res.status: eq 400
  res.body.errorCode: eq PROTOCOL_REVIEW_OBSERVATIONS_REQUIRED
}

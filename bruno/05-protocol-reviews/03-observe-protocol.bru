meta {
  name: 03-observe-protocol
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "status": "OBSERVED",
    "observations": "Falta el certificado de buenas practicas actualizado"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("reviewId1", res.body.id);
}

assert {
  res.status: eq 201
  res.body.status: eq OBSERVED
  res.body.reviewer.username: eq {{adminUsername}}
}

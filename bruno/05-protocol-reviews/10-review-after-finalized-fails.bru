meta {
  name: 10-review-after-finalized-fails
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "status": "OBSERVED",
    "observations": "No deberia poder revisarse de nuevo"
  }
}

assert {
  res.status: eq 409
  res.body.errorCode: eq PROTOCOL_REVIEW_PROTOCOL_ALREADY_FINALIZED
}

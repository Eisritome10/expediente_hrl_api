meta {
  name: 02-observe-invalid-outcome-rejected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "committee": "CIC",
    "outcome": "FINALIZED",
    "observations": "outcome invalido para CIC"
  }
}

assert {
  res.status: eq 400
  res.body.errorCode: eq PROTOCOL_REVIEW_INVALID_OUTCOME_FOR_COMMITTEE
}

meta {
  name: 11-cic-review-after-approval-fails
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "committee": "CIC",
    "outcome": "OBSERVED",
    "observations": "CIC ya deberia estar cerrado"
  }
}

assert {
  res.status: eq 409
  res.body.errorCode: eq PROTOCOL_REVIEW_COMMITTEE_CLOSED
}

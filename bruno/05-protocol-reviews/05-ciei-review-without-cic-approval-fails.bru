meta {
  name: 05-ciei-review-without-cic-approval-fails
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "committee": "CIEI",
    "outcome": "OBSERVED",
    "observations": "no deberia poder observar todavia"
  }
}

assert {
  res.status: eq 409
  res.body.errorCode: eq PROTOCOL_REVIEW_CIC_APPROVAL_REQUIRED
}

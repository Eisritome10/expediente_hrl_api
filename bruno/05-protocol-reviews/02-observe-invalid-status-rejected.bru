meta {
  name: 02-observe-invalid-status-rejected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "status": "CORRECTED",
    "observations": "Este estado no deberia ser aceptado en una revision"
  }
}

assert {
  res.status: eq 400
}

meta {
  name: 07-correct-cic-protocol
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/protocols/{{protocolId}}
  body: json
  auth: inherit
}

body:json {
  {
    "titulo": "Estudio de prueba Bruno corregido"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq CIC_CORRECTED
  res.body.titulo: eq ESTUDIO DE PRUEBA BRUNO CORREGIDO
  res.body.lugarEjecucion: eq HOSPITAL REGIONAL DE LORETO
}

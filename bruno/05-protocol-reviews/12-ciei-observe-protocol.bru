meta {
  name: 12-ciei-observe-protocol
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "committee": "CIEI",
    "outcome": "OBSERVED",
    "observations": "Falta especificar el nivel de riesgo"
  }
}

assert {
  res.status: eq 201
  res.body.committee: eq CIEI
  res.body.outcome: eq OBSERVED
}

meta {
  name: 08-patch-again-while-cic-corrected-fails
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/protocols/{{protocolId}}
  body: json
  auth: inherit
}

body:json {
  {
    "titulo": "No deberia poder corregirse dos veces seguidas"
  }
}

assert {
  res.status: eq 409
  res.body.errorCode: eq PROTOCOL_NOT_OBSERVED
}

meta {
  name: 09-cic-approve-protocol
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/protocols/{{protocolId}}/reviews
  body: json
  auth: inherit
}

body:json {
  {
    "committee": "CIC",
    "outcome": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.committee: eq CIC
  res.body.outcome: eq APPROVED
  res.body.observations: isNull
}

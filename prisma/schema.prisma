generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Researcher {
  id        String   @id @default(uuid())
  dni       String   @unique @db.VarChar(8)
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolsAsPrincipal      Protocol[]               @relation("ProtocolInvestigadorPrincipal")
  protocolCoinvestigaciones ProtocolCoinvestigador[]  @relation("ProtocolCoinvestigadores")
  protocolAsesorias         ProtocolAsesor[]          @relation("ProtocolAsesores")

  @@map("researchers")
}

model Institution {
  id            String   @id @default(uuid())
  name          String   @unique
  abbreviation  String?
  esUniversidad Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@map("institutions")
}

model Faculty {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@map("faculties")
}

model Destination {
  id          String @id @default(uuid())
  description String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolDestinos ProtocolDestino[]

  @@map("destinations")
}

enum UserRole {
  ADMIN
  NURSE
  DOCTOR
  STATISTICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  passwordHash String
  role         UserRole   @default(NURSE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum LineType {
  HRL
  META_2030
}

model ResearchLine {
  id   String   @id @default(uuid())
  name String
  type LineType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolsAsLineaHrl      Protocol[] @relation("ProtocolLineaHrl")
  protocolsAsLineaMeta2030 Protocol[] @relation("ProtocolLineaMeta2030")

  @@unique([name, type])
  @@map("research_lines")
}

model Modality {
  id   String  @id @default(uuid())
  name String  @unique
  fee  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@map("modalities")
}

model Protocol {
  id String @id @default(uuid())

  nroExpediente   String   @unique
  fechaRecepcion  DateTime
  titulo          String
  disenoEstudio   String
  lugarEjecucion  String
  esInstitucional Boolean  @default(true)

  investigadorPrincipalId String
  investigadorPrincipal   Researcher @relation("ProtocolInvestigadorPrincipal", fields: [investigadorPrincipalId], references: [id])

  institucionId String?
  institucion   Institution? @relation(fields: [institucionId], references: [id])

  facultadId String?
  facultad   Faculty? @relation(fields: [facultadId], references: [id])

  lineaHrlId String
  lineaHrl   ResearchLine @relation("ProtocolLineaHrl", fields: [lineaHrlId], references: [id])

  lineaMeta2030Id String
  lineaMeta2030   ResearchLine @relation("ProtocolLineaMeta2030", fields: [lineaMeta2030Id], references: [id])

  modalidadId String
  modalidad   Modality @relation(fields: [modalidadId], references: [id])

  propositoRevision   String
  fechaRevision       DateTime?
  tipoComprobante     String?
  comprobanteRevision String?
  pagoRevision        Decimal? @db.Decimal(10, 2)

  esEnmienda Boolean @default(false)

  esConvenio     Boolean @default(false)
  nombreConvenio String?

  requiereRevisionHc Boolean  @default(false)
  montoHc            Decimal? @db.Decimal(10, 2)
  tipoComprobanteHc  String?
  nroComprobanteHc   String?

  certificadoBuenasPracticas Boolean @default(false)

  coinvestigadores ProtocolCoinvestigador[]
  asesores         ProtocolAsesor[]
  destinos         ProtocolDestino[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("protocols")
}

model ProtocolCoinvestigador {
  protocolId   String
  protocol     Protocol   @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  researcherId String
  researcher   Researcher @relation("ProtocolCoinvestigadores", fields: [researcherId], references: [id])

  @@id([protocolId, researcherId])
  @@map("protocol_coinvestigadores")
}

model ProtocolAsesor {
  protocolId   String
  protocol     Protocol   @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  researcherId String
  researcher   Researcher @relation("ProtocolAsesores", fields: [researcherId], references: [id])

  @@id([protocolId, researcherId])
  @@map("protocol_asesores")
}

model ProtocolDestino {
  protocolId    String
  protocol      Protocol    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@id([protocolId, destinationId])
  @@map("protocol_destinos")
}

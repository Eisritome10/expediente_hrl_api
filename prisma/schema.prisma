generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Researcher {
  id        String   @id @default(uuid())
  dni       String   @unique @db.VarChar(8)
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("researchers")
}

model Institution {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutions")
}

model Faculty {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faculties")
}

model Destination {
  id          String @id @default(uuid())
  description String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("destinations")
}

enum UserRole {
  ADMIN
  NURSE
  DOCTOR
  STATISTICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  passwordHash String
  role         UserRole   @default(NURSE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum LineType {
  HRL
  META_2030
}

model ResearchLine {
  id   String   @id @default(uuid())
  name String
  type LineType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@map("research_lines")
}

model Modality {
  id   String  @id @default(uuid())
  name String  @unique
  fee  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modalities")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Researcher {
  id        String   @id @default(uuid())
  dni       String   @unique @db.VarChar(8)
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("researchers")
}

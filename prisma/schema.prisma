generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Researcher {
  id        String   @id @default(uuid())
  dni       String   @unique @db.VarChar(8)
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolsAsPrincipal      Protocol[]               @relation("ProtocolInvestigadorPrincipal")
  protocolCoinvestigaciones ProtocolCoinvestigador[]  @relation("ProtocolCoinvestigadores")
  protocolAsesorias         ProtocolAsesor[]          @relation("ProtocolAsesores")
  user                      User?

  @@map("researchers")
}

enum InstitutionType {
  HOSPITAL
  UNIVERSITY
  OTHER
}

model Institution {
  id           String          @id @default(uuid())
  name         String          @unique
  abbreviation String?
  type         InstitutionType @default(OTHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Solo las universidades tienen facultades, cargadas a mano para cada una.
  faculties Faculty[]
  protocols Protocol[]

  @@map("institutions")
}

model Faculty {
  id   String @id @default(uuid())
  name String

  // Nulo solo en facultades históricas del catálogo global anterior; las nuevas siempre pertenecen a una universidad.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@unique([institutionId, name])
  @@map("faculties")
}

model Agreement {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@map("agreements")
}

model Destination {
  id          String @id @default(uuid())
  description String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolDestinos ProtocolDestino[]

  @@map("destinations")
}

enum UserRole {
  ADMIN
  NURSE
  DOCTOR
  STATISTICIAN
  RESEARCHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  passwordHash String
  role         UserRole   @default(NURSE)
  status       UserStatus @default(ACTIVE)
  email        String?    @unique
  researcherId String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolReviews ProtocolReview[]
  researcher      Researcher?     @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@map("users")
}

enum LineType {
  HRL
  META_2030
}

model ResearchLine {
  id   String   @id @default(uuid())
  name String
  type LineType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolsAsLineaHrl      Protocol[] @relation("ProtocolLineaHrl")
  protocolsAsLineaMeta2030 Protocol[] @relation("ProtocolLineaMeta2030")

  @@unique([name, type])
  @@map("research_lines")
}

model StudyDesign {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolStudyDesigns ProtocolStudyDesign[]

  @@map("study_designs")
}

model Modality {
  id   String  @id @default(uuid())
  name String  @unique
  fee  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols Protocol[]

  @@map("modalities")
}

enum ProtocolStatus {
  CREATED
  CIC_OBSERVED
  CIC_CORRECTED
  CIEI_OBSERVED
  CIEI_CORRECTED
  FINALIZED
}

enum Committee {
  CIC
  CIEI
}

enum ReviewOutcome {
  OBSERVED
  APPROVED
  FINALIZED
}

enum RiskLevel {
  NO_RISK
  MINIMAL_RISK
  MODERATE_RISK
  HIGH_RISK
}

model Protocol {
  id String @id @default(uuid())

  status ProtocolStatus @default(CREATED)

  nroExpediente   String   @unique
  fechaRecepcion  DateTime
  titulo          String
  lugarEjecucion  String
  esInstitucional Boolean  @default(true)

  investigadorPrincipalId String
  investigadorPrincipal   Researcher @relation("ProtocolInvestigadorPrincipal", fields: [investigadorPrincipalId], references: [id])

  institucionId String?
  institucion   Institution? @relation(fields: [institucionId], references: [id])

  facultadId String?
  facultad   Faculty? @relation(fields: [facultadId], references: [id])

  convenioId String?
  convenio   Agreement? @relation(fields: [convenioId], references: [id], onDelete: Restrict)

  lineaHrlId String
  lineaHrl   ResearchLine @relation("ProtocolLineaHrl", fields: [lineaHrlId], references: [id])

  lineaMeta2030Id String
  lineaMeta2030   ResearchLine @relation("ProtocolLineaMeta2030", fields: [lineaMeta2030Id], references: [id])

  modalidadId String
  modalidad   Modality @relation(fields: [modalidadId], references: [id])

  propositoRevision   String?
  fechaRevision       DateTime?
  tipoComprobante     String?
  comprobanteRevision String?
  pagoRevision        Decimal? @db.Decimal(10, 2)

  esEnmienda Boolean @default(false)

  protocoloOriginalId String?
  protocoloOriginal   Protocol?  @relation("ProtocolEnmiendas", fields: [protocoloOriginalId], references: [id], onDelete: Restrict)
  enmiendas           Protocol[] @relation("ProtocolEnmiendas")

  requiereRevisionHc Boolean  @default(false)
  montoHc            Decimal? @db.Decimal(10, 2)
  tipoComprobanteHc  String?
  nroComprobanteHc   String?

  certificadoBuenasPracticas Boolean @default(false)

  tieneConstanciaEtica         Boolean   @default(false)
  idConstanciaEtica            String?
  fechaConstancia               DateTime?
  catalogadoRiesgo              RiskLevel?
  consentimientoInformado       Boolean   @default(false)
  departamentoDirigidoPermiso   String?

  coinvestigadores ProtocolCoinvestigador[]
  asesores         ProtocolAsesor[]
  destinos         ProtocolDestino[]
  disenosEstudio   ProtocolStudyDesign[]
  reviews          ProtocolReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("protocols")
}

model ProtocolReview {
  id String @id @default(uuid())

  protocolId String
  protocol   Protocol @relation(fields: [protocolId], references: [id], onDelete: Restrict)

  reviewerId String
  reviewer   User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  committee    Committee
  outcome      ReviewOutcome
  observations String?

  observationItems ProtocolReviewObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("protocol_reviews")
}

enum ObservationType {
  INFORMED_CONSENT
  ETHICS_CONSTANCE
  ADMINISTRATIVE
  METHODOLOGICAL
  LEGAL_INSTITUTIONAL
}

model ProtocolReviewObservation {
  id String @id @default(uuid())

  reviewId String
  review   ProtocolReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  type ObservationType
  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@map("protocol_review_observations")
}

model ProtocolCoinvestigador {
  protocolId   String
  protocol     Protocol   @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  researcherId String
  researcher   Researcher @relation("ProtocolCoinvestigadores", fields: [researcherId], references: [id])

  @@id([protocolId, researcherId])
  @@map("protocol_coinvestigadores")
}

model ProtocolAsesor {
  protocolId   String
  protocol     Protocol   @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  researcherId String
  researcher   Researcher @relation("ProtocolAsesores", fields: [researcherId], references: [id])

  @@id([protocolId, researcherId])
  @@map("protocol_asesores")
}

model ProtocolDestino {
  protocolId    String
  protocol      Protocol    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@id([protocolId, destinationId])
  @@map("protocol_destinos")
}

model ProtocolStudyDesign {
  protocolId    String
  protocol      Protocol    @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  studyDesignId String
  studyDesign   StudyDesign @relation(fields: [studyDesignId], references: [id])

  @@id([protocolId, studyDesignId])
  @@map("protocol_study_designs")
}
